# ╔══════════════════════════════════════════════════════════╗
# ║  Шаблон .env для проекту Karro                          ║
# ║  Скопіюй цей файл у .env і заповни своїми значеннями    ║
# ╚══════════════════════════════════════════════════════════╝

# Згенеруй новий ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite (для розробки) — True/False
USE_SQLITE=True

# База даних MySQL (потрібно лише якщо USE_SQLITE=False)
DB_NAME=STO_app
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
